        android:pathData="M45.5,42 h5 v26 h-5 z M70.5,35 h5 v28 h-5 z" />
    <!-- Heads: tilted ovals. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M32.5,68 a9,7 -20 1,0 18,0 a9,7 -20 1,0 -18,0 z M57.5,63 a9,7 -20 1,0 18,0 a9,7 -20 1,0 -18,0 z" />
