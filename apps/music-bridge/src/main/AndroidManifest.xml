<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Only apps signed with this app's key can hold this, and Multi Scrobbler's receiver in
        Discord only accepts broadcasts from a holder. So nothing else can feed Discord a song.
    -->
    <permission
        android:name="com.bleelblep.musicbridge.permission.SEND_NOW_PLAYING"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.bleelblep.musicbridge.permission.SEND_NOW_PLAYING" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Deliberately no foreground service and so no notification in the shade: a foreground
        service is only allowed to exist behind one, and the entry is unwanted (it was also
        refused from the background, so it never kept anything up anyway). Background liveness
        comes from an ordinary started service (KeepAlive) and the Heartbeat alarm instead;
        neither needs a permission of its own.
    -->

    <!-- Lets this app address Discord on Android 11+. No internet permission: nothing leaves the phone. -->
    <queries>
        <package android:name="app.valenced" />
        <package android:name="com.discord" />
        <!-- Music apps, for the Apps screen's list of players. -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <!-- Launcher apps, so a player shows by its name ("Spotify") rather than its package. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MusicBridge">

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!--
            The app drawer icon, separate from MainActivity so it can be switched off
            (LauncherIcon) while Multi Scrobbler can still open MainActivity directly.
        -->
        <activity-alias
            android:name=".Launcher"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".ListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".KeepAlive"
            android:exported="false" />

        <!-- Fires only if publishing stopped; see Heartbeat. -->
        <receiver
            android:name=".Heartbeat"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
